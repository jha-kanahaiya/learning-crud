@model IReadOnlyList<LearningCrud.Web.Models.LearningItem>
@{
    ViewData["Title"] = "Learning items";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Learning items</h1>
        <p class="text-muted mb-0">Keep track of concepts you want to explore.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add an item</a>
</div>

@if (Model.Count == 0)
{
    <div class="border rounded p-4 bg-light">
        <h2 class="h5">Nothing here yet</h2>
        <p class="mb-3">Create your first learning item to try the CRUD workflow.</p>
        <a asp-action="Create" class="btn btn-outline-primary">Create your first item</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Your learning items</caption>
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Description</th>
                    <th scope="col">Created (UTC)</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">
                            <a asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                        </th>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</td>
                        <td><time datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</time></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
